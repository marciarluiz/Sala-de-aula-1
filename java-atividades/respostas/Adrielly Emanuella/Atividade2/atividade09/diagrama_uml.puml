@startuml
skinparam classAttributeIconSize 0

class Computador {
  - sistemaOperacional : String
  + Computador(marca : String, ligado : boolean, sistemaOperacional : String)
  + getSistemaOperacional() : String
  + setSistemaOperacional(sistemaOperacional : String) : void
  + ligar() : void
  + exibirEstado() : void
}

class Dispositivo {
  - marca : String
  - ligado : boolean
  + Dispositivo(marca : String, ligado : boolean)
  + getMarca() : String
  + setMarca(marca : String) : void
  + isLigado() : boolean
  # setLigado(ligado : boolean) : void
  + ligar() : void
  + desligar() : void
  + exibirEstado() : void
}

class Televisao {
  - canal : int
  + Televisao(marca : String, ligado : boolean, canal : int)
  + getCanal() : int
  + setCanal(canal : int) : void
  + ligar() : void
  + exibirEstado() : void
}

Computador --|> Dispositivo
Televisao --|> Dispositivo
@enduml
